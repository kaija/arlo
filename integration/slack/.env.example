# Copy to .env and fill in. Never commit .env.

# --- Slack (required) ------------------------------------------------------
# Bot token from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write, from Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-...

# --- Model provider (at least one) -----------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://custom-endpoint.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# BRAVE_API_KEY=...            # enables the web search tool

# Model passed to `arlo --model`, format: provider:model
ARLO_MODEL=openai:gpt-4o

# --- Access control (empty = every channel the bot is a member of) ---------
# SLACK_ALLOWED_CHANNELS=C0123ABCD,C0456EFGH
# SLACK_ALLOWED_USERS=U0123ABCD

# --- Tuning (defaults shown) -----------------------------------------------
# CHANNEL_HISTORY_LIMIT=20
# THREAD_HISTORY_LIMIT=100
# HISTORY_CHAR_BUDGET=12000
# RUN_TIMEOUT_SECONDS=300
# MAX_CONCURRENT_RUNS=4
# UPDATE_INTERVAL_SECONDS=1.0
# MAX_MESSAGE_CHARS=3800
# SHUTDOWN_GRACE_SECONDS=30
# LOG_LEVEL=INFO

# ARLO_URL is set by docker-compose.yml (http://arlo:8080/) — do NOT set it here
