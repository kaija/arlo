# arlo environment variables.
# arlo does not read .env files itself — load it into your shell first:
#   cp .env.example .env && set -a && source .env && set +a
# Used when no profile is configured in .arlo/settings.json.

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Wire API: "chat" (default, /chat/completions) or "responses" (/responses).
# Use "responses" for reasoning models that reject function tools on chat.
OPENAI_API=chat
# Reasoning effort: none | minimal | low | medium | high (model-dependent)
# OPENAI_REASONING_EFFORT=medium
# Reasoning summary (responses API only): auto | concise | detailed
# OPENAI_REASONING_SUMMARY=auto

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Ollama (requires the "ollama" feature) ---
# OLLAMA_HOST=http://localhost:11434

# --- Tools ---
# BRAVE_API_KEY=   # web_search tool
